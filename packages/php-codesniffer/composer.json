{
    "name": "dpi/namespace-shortener-phpcs",
    "description": "PHP_CodeSniffer standard that imports configured namespace roots and rewrites every usage to go through them",
    "type": "phpcodesniffer-standard",
    "license": "BSD-3-Clause",
    "keywords": ["phpcs", "phpcbf", "php_codesniffer", "standards", "namespace", "imports", "coding-standard", "dev"],
    "homepage": "https://dpi.github.io/namespace-shortener/",
    "support": {
        "docs": "https://dpi.github.io/namespace-shortener/",
        "source": "https://github.com/dpi/namespace-shortener"
    },
    "require": {
        "php": ">=8.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "dpi/namespace-shortener-core": "self.version",
        "nikic/php-parser": "^5.6",
        "squizlabs/php_codesniffer": "^3.13 || ^4.0",
        "thecodingmachine/safe": "^3.4"
    },
    "autoload": {
        "files": ["src/tokens.php"],
        "psr-4": {
            "Dpi\\NamespaceShortener\\PhpCodeSniffer\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
